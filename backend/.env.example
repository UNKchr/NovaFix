# ==============================================================================
# NOVAFIX BACKEND - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# REGLAS DE SEGURIDAD PARA CARACTERES ESPECIALES:
# - En contraseñas de URLs (DATABASE_URL, REDIS_URL) y en secretos (JWT_SECRET),
#   utiliza EXCLUSIVAMENTE caracteres alfanuméricos (A-Z, a-z, 0-9) o hexadecimales (0-9, a-f).
# - EVITA caracteres especiales como: $ " ' ` # & ? @ / \ % = espacios
#   ya que rompen el parser de archivos .env, la interpolación de variables en
#   PowerShell/Bash o el formato URI de conexión de PostgreSQL/Redis.
# ==============================================================================

# 1. NODE_ENV
# Propósito: Define el modo de ejecución del servidor. En "production" oculta trazas
#            de error internas y refuerza políticas de seguridad.
# Valores permitidos: development | production | test
NODE_ENV="development"

# 2. PORT
# Propósito: Puerto TCP local donde escuchará el servidor HTTP Express.
# Formato recomendado: Número entero entre 1024 y 65535 (4 dígitos, ej. 3000).
PORT=3000

# 3. DATABASE_URL
# Propósito: Cadena de conexión a PostgreSQL (Docker en local / Neon.tech en producción).
# Recomendación para usuario/password: 16 a 32 caracteres alfanuméricos (solo letras y números,
# sin @, :, /, ? ni # para no corromper la URI).
DATABASE_URL="postgresql://novafix_user:novafix_local_pass@localhost:5432/novafix_db?schema=public"

# 4. REDIS_URL
# Propósito: Cadena de conexión al servidor Redis para caché Cache-Aside, revocación de sesiones
#            y control de Rate Limit / Baneo de IPs.
# Formato: redis://localhost:6379 (local) o rediss://default:<TOKEN_ALFANUMERICO>@<HOST>:6379 (Upstash TLS).
REDIS_URL="redis://localhost:6379"

# 5. FRONTEND_URL
# Propósito: Origen exacto autorizado en la política CORS (sin barra final "/").
#            Prohibido usar "*".
FRONTEND_URL="http://localhost:4200"

# 6. CACHE_TTL_SECONDS
# Propósito: Tiempo de vida en segundos de las órdenes almacenadas en caché Redis (Cache-Aside).
# Recomendación: 300 (5 minutos).
CACHE_TTL_SECONDS=300

# 7. JWT_SECRET
# Propósito: Clave maestra criptográfica para firmar y verificar los tokens de sesión (HMAC-SHA256).
# Longitud recomendada: 64 caracteres hexadecimales (equivalente a 32 bytes / 256 bits de entropía).
# Caracteres permitidos: Solo alfanuméricos (A-Z, a-z, 0-9). Mínimo obligatorio: 32 caracteres.
# Cómo generarlo en terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="REEMPLAZAR_CON_TU_SECRETO_HEXADECIMAL_DE_64_CARACTERES"

# 8. JWT_EXPIRES_IN_HOURS
# Propósito: Duración máxima de una sesión activa antes de exigir un nuevo inicio de sesión.
# Recomendación: Número entero entre 1 y 24 (ej. 8 o 12 horas para jornada laboral).
JWT_EXPIRES_IN_HOURS=12

# 9. SEGURIDAD DE RED, WHITELIST, BLACKLIST Y RATE LIMITING (OPCIONALES)
# TRUST_PROXY: Activar ("true") únicamente cuando el backend opere detrás de Nginx / Cloudflare / Render.
TRUST_PROXY="false"

# Listas de IPs separadas por coma (ej. "192.168.1.50,10.0.0.15")
IP_WHITELIST=""
IP_BLACKLIST=""

# Límites máximos de peticiones por minuto por IP según sensibilidad de la ruta
RATE_LIMIT_GLOBAL_MAX=180
RATE_LIMIT_AUTH_MAX=6
RATE_LIMIT_PUBLIC_TRACKING_MAX=20
