// ============================================================================
// NOVAFIX - PRISMA ORM v7 SCHEMA
// (MULTI-TENANT, RBAC/ABAC, DOUBLE-FIFO QUEUE, NOTIFICATIONS & SOFT-DELETE)
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  CREATED
  ASSIGNING
  DIAGNOSING
  IN_REPAIR
  READY
  DELIVERED
  CANCELLED
}

enum OrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PermissionPreset {
  RECEPTION_AGENT
  RECEPTION_SUPERVISOR
  TECHNICAL_SPECIALIST
  TECHNICAL_SUPERVISOR
  CUSTOM
}

enum PermissionCode {
  MANAGE_AREAS
  MANAGE_USERS
  ORDER_CREATE
  ORDER_DELETE
  ORDER_ASSIGN_QUEUE
  ORDER_STATUS_DIAGNOSING
  ORDER_STATUS_IN_REPAIR
  ORDER_STATUS_READY
  ORDER_STATUS_CANCELLED
  ORDER_STATUS_DELIVERED
  ORDER_VIEW_AREA
  ORDER_VIEW_ALL_COMPANY
}

enum NotificationType {
  ORDER_CREATED_ASSIGNED
  ORDER_QUEUED_IN_AREA
  ORDER_ASSIGNED_FROM_QUEUE
  ORDER_REASSIGNED
  ORDER_STATUS_PROGRESS
  ORDER_READY_FOR_PICKUP
  ORDER_CANCELLED_ALERT
  ORDER_DELIVERED_CLOSED
  ORDER_VOIDED_DELETED
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(80)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  areas         Area[]
  users         User[]
  repairOrders  RepairOrder[]
  notifications Notification[]

  @@map("companies")
}

model Area {
  id               String           @id @default(uuid()) @db.Uuid
  companyId        String           @map("company_id") @db.Uuid
  name             String           @db.VarChar(80)
  description      String?          @db.VarChar(255)
  isTechnicalQueue Boolean          @default(false) @map("is_technical_queue")
  defaultPreset    PermissionPreset @default(CUSTOM) @map("default_preset")
  isActive         Boolean          @default(true) @map("is_active")
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions      AreaPermission[]
  users            User[]
  originatedOrders RepairOrder[]    @relation("OriginAreaOrders")
  targetedOrders   RepairOrder[]    @relation("TargetAreaOrders")
  notifications    Notification[]

  @@unique([companyId, name])
  @@index([companyId, isActive, deletedAt])
  @@index([companyId, isTechnicalQueue, isActive])
  @@map("areas")
}

model AreaPermission {
  id         String         @id @default(uuid()) @db.Uuid
  areaId     String         @map("area_id") @db.Uuid
  permission PermissionCode

  area Area @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([areaId, permission])
  @@map("area_permissions")
}

model User {
  id               String           @id @default(uuid()) @db.Uuid
  companyId        String           @map("company_id") @db.Uuid
  areaId           String?          @map("area_id") @db.Uuid
  email            String           @unique @db.VarChar(150)
  fullName         String           @map("full_name") @db.VarChar(100)
  passwordHash     String           @map("password_hash") @db.VarChar(255)
  passwordSalt     String           @map("password_salt") @db.VarChar(128)
  isCompanyAdmin   Boolean          @default(false) @map("is_company_admin")
  permissionPreset PermissionPreset @default(CUSTOM) @map("permission_preset")
  isActive         Boolean          @default(true) @map("is_active")
  availableSince   DateTime         @default(now()) @map("available_since") @db.Timestamptz(3)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  company               Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  area                  Area?                @relation(fields: [areaId], references: [id], onDelete: SetNull)
  customPermissions     UserPermission[]
  createdOrders         RepairOrder[]        @relation("CreatedByOrders")
  assignedOrders        RepairOrder[]        @relation("AssignedToOrders")
  deletedOrders         RepairOrder[]        @relation("DeletedByOrders")
  statusHistoryEntries  OrderStatusHistory[]
  sentNotifications     Notification[]       @relation("ActorNotifications")
  receivedNotifications Notification[]       @relation("RecipientNotifications")

  @@index([companyId, areaId, isActive, deletedAt, availableSince(sort: Asc)])
  @@index([companyId, isActive, deletedAt])
  @@map("users")
}

model UserPermission {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  permission PermissionCode

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@map("user_permissions")
}

model RepairOrder {
  id                 String        @id @default(uuid()) @db.Uuid
  companyId          String        @map("company_id") @db.Uuid
  ticketCode         String        @unique @map("ticket_code") @db.VarChar(16)
  status             OrderStatus   @default(CREATED)
  priority           OrderPriority @default(NORMAL)
  clientName         String        @map("client_name") @db.VarChar(100)
  clientContact      String        @map("client_contact") @db.VarChar(100)
  deviceModel        String        @map("device_model") @db.VarChar(100)
  issueDesc          String        @map("issue_desc") @db.VarChar(1000)
  resolutionNotes    String?       @map("resolution_notes") @db.VarChar(1000)
  cancellationReason String?       @map("cancellation_reason") @db.VarChar(1000)
  createdById        String        @map("created_by_id") @db.Uuid
  originAreaId       String?       @map("origin_area_id") @db.Uuid
  targetAreaId       String        @map("target_area_id") @db.Uuid
  assignedToId       String?       @map("assigned_to_id") @db.Uuid
  deletedById        String?       @map("deleted_by_id") @db.Uuid
  queuedAt           DateTime      @default(now()) @map("queued_at") @db.Timestamptz(3)
  assignedAt         DateTime?     @map("assigned_at") @db.Timestamptz(3)
  completedAt        DateTime?     @map("completed_at") @db.Timestamptz(3)
  deliveredAt        DateTime?     @map("delivered_at") @db.Timestamptz(3)
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy     User                 @relation("CreatedByOrders", fields: [createdById], references: [id], onDelete: Restrict)
  originArea    Area?                @relation("OriginAreaOrders", fields: [originAreaId], references: [id], onDelete: SetNull)
  targetArea    Area                 @relation("TargetAreaOrders", fields: [targetAreaId], references: [id], onDelete: Restrict)
  assignedTo    User?                @relation("AssignedToOrders", fields: [assignedToId], references: [id], onDelete: SetNull)
  deletedBy     User?                @relation("DeletedByOrders", fields: [deletedById], references: [id], onDelete: SetNull)
  statusHistory OrderStatusHistory[]
  notifications Notification[]

  @@index([companyId, deletedAt, status])
  @@index([companyId, originAreaId, deletedAt, createdAt(sort: Desc)])
  @@index([companyId, targetAreaId, deletedAt, status, priority(sort: Desc), queuedAt(sort: Asc)])
  @@index([assignedToId, deletedAt, status])
  @@index([createdById, deletedAt, status])
  @@index([createdAt(sort: Desc)])
  @@map("repair_orders")
}

model OrderStatusHistory {
  id             String       @id @default(uuid()) @db.Uuid
  repairOrderId  String       @map("repair_order_id") @db.Uuid
  previousStatus OrderStatus? @map("previous_status")
  newStatus      OrderStatus  @map("new_status")
  changedById    String       @map("changed_by_id") @db.Uuid
  comment        String?      @db.VarChar(1000)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  changedBy   User        @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([repairOrderId, createdAt(sort: Desc)])
  @@map("order_status_history")
}

model Notification {
  id                  String           @id @default(uuid()) @db.Uuid
  companyId           String           @map("company_id") @db.Uuid
  repairOrderId       String           @map("repair_order_id") @db.Uuid
  actorUserId         String           @map("actor_user_id") @db.Uuid
  recipientUserId     String?          @map("recipient_user_id") @db.Uuid
  recipientAreaId     String?          @map("recipient_area_id") @db.Uuid
  type                NotificationType
  title               String           @db.VarChar(150)
  message             String           @db.VarChar(500)
  isRead              Boolean          @default(false) @map("is_read")
  readAt              DateTime?        @map("read_at") @db.Timestamptz(3)
  isHiddenByRecipient Boolean          @default(false) @map("is_hidden_by_recipient")
  hiddenAt            DateTime?        @map("hidden_at") @db.Timestamptz(3)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  actorUser     User        @relation("ActorNotifications", fields: [actorUserId], references: [id], onDelete: Cascade)
  recipientUser User?       @relation("RecipientNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientArea Area?       @relation(fields: [recipientAreaId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, isHiddenByRecipient, isRead, createdAt(sort: Desc)])
  @@index([recipientAreaId, isHiddenByRecipient, isRead, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("notifications")
}
